generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Pengguna {
  id           Int      @id @default(autoincrement())
  nama         String
  email        String   @unique
  passwordHash String
  role         String   @default("mahasiswa")
  createdAt    DateTime @default(now())

  @@map("pengguna")
}
