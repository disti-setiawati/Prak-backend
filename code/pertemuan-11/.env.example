# Lokasi file database relatif terhadap direktori project.
DATABASE_URL="file:./prisma/dev.db"

# Port HTTP yang didengarkan server.
PORT=3011

# Origin yang diizinkan CORS, dipisah koma. Client lain akan ditolak browser.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Jumlah request maksimal per window sebelum rate limiter mengirim 429.
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX=20
